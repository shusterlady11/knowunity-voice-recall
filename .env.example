# Chromatic project token (get it from your Chromatic project settings)
CHROMATIC_PROJECT_TOKEN=

# Anthropic API key for the recall judge. Read by server routes only, never sent to the browser.
ANTHROPIC_API_KEY=

# OpenAI API key for speech-to-text (gpt-transcribe) in live sessions. Server routes only, never sent to the browser.
OPENAI_API_KEY=
